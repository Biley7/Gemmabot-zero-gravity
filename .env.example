# ── GemmaBot environment template ─────────────────────────────────────────
# Copy this file to .env and replace the placeholder values:
#
#     cp .env.example .env
#
# The values below are PLACEHOLDERS, not credentials.  Never commit a real
# key: .env and every .env.* variant are gitignored and excluded from the
# Docker build context.  A key that has ever been shared must be rotated.

# Required only for the API / Auto engine and for live map vision.
# Leave the placeholder to run Local (Ollama) or a scripted dry mode.
GEMINI_API_KEY=REPLACE_WITH_YOUR_OWN_KEY

# Optional overrides — defaults live in gemmabot/config.py.
GEMMA_API_MODEL=gemma-4-26b-a4b-it
OLLAMA_MODEL=gemma4:e4b
MAX_REPAIRS=2

# OpenAI-compatible planner (optional) — any endpoint that speaks the
# chat-completions shape: OpenAI, vLLM, LM Studio, Ollama's OpenAI mode.
# OPENAI_MODEL is whatever the endpoint serves; a key is required only for
# the hosted OpenAI endpoint (https://api.openai.com/v1).
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=REPLACE_WITH_YOUR_KEY
OPENAI_TIMEOUT=120
